<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Ritav local security/audit state is not transferable to another device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
